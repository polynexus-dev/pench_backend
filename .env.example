# Copy this file to .env and fill in your values
SECRET_KEY=django-insecure-replace-this-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL + PostGIS
DB_NAME=delivery_erp
DB_USER=postgres
DB_PASSWORD=admin
DB_HOST=localhost
DB_PORT=5432

# Redis (Celery broker)
REDIS_URL=redis://localhost:6379/0

# OSRM routing engine (public demo or self-hosted)
OSRM_BASE_URL=http://router.project-osrm.org

# Depot/warehouse coordinates (lon, lat) used as OR-Tools depot (index 0)
# Default below is Mumbai
DEPOT_LAT=19.0760
DEPOT_LON=72.8777

# Route optimization time limit (seconds)
ROUTE_OPTIMIZATION_TIME_LIMIT_SECONDS=5
