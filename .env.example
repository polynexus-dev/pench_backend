# Copy this file to .env and fill in your values
SECRET_KEY=django-insecure-replace-this-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL + PostGIS
DB_NAME=delivery_erp
DB_USER=postgres
DB_PASSWORD=admin
DB_HOST=localhost
DB_PORT=5432

# Redis (Celery broker)
REDIS_URL=redis://localhost:6379/0

# OSRM routing engine (public demo or self-hosted)
OSRM_BASE_URL=http://router.project-osrm.org

# Depot/warehouse coordinates (lon, lat) used as OR-Tools depot (index 0)
# Default below is Mumbai
DEPOT_LAT=19.0760
DEPOT_LON=72.8777

# Route optimization time limit (seconds)
ROUTE_OPTIMIZATION_TIME_LIMIT_SECONDS=5

# GIS / GDAL (Set to False if GDAL is not installed)
HAS_GDAL=True

# Firebase Config (for FCM push notifications)
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=pench-784c5
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="AIzaSyBhzCec2A_sI36QMsxYGrf1ocns6O85FGQ"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_CERT_URL=https://www.googleapis.com/oauth2/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project.iam.gserviceaccount.com
FIREBASE_UNIVERSE_DOMAIN=googleapis.com

