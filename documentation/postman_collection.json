              "name": "Bulk Create Orders",
              "request": {
                "method": "POST",
                "body": { "mode": "raw", "raw": "[\n  {\n    \"customer\": \"{{customer_id}}\",\n    \"scheduled_delivery_date\": \"2026-05-08\",\n    \"items\": [\n      {\n        \"product\": \"{{product_id}}\",\n        \"quantity\": 2\n      }\n    ]\n  }\n]", "options": { "raw": { "language": "json" } } },
                "url": {
                  "raw": "{{city_url}}/api/erp/orders/",
                  "host": ["{{city_url}}"],
                  "path": ["api", "erp", "orders", ""]
                }
              }
            },
            {
              "name": "Bulk Update Orders",
              "request": {
                "method": "PATCH",
                "body": { "mode": "raw", "raw": "[{\"id\": \"{{order_id}}\", \"status\": \"delivered\"}]", "options": { "raw": { "language": "json" } } },
                "url": {
                  "raw": "{{city_url}}/api/erp/orders/bulk_update/",
                  "host": ["{{city_url}}"],
                  "path": ["api", "erp", "orders", "bulk_update", ""]
                }
              }
            }
          ]
        },
        {
          "name": "Routes & Trips",
          "item": [
            {
              "name": "Create Optimized Route",
              "request": {
                "method": "POST",
                "body": { "mode": "raw", "raw": "{\n  \"name\": \"Route A\",\n  \"delivery_date\": \"2026-05-08\",\n  \"order_ids\": [\"{{order_id_1}}\", \"{{order_id_2}}\"]\n}", "options": { "raw": { "language": "json" } } },
                "url": {
                  "raw": "{{city_url}}/api/erp/orders/routes/create-optimized/",
                  "host": ["{{city_url}}"],
                  "path": ["api", "erp", "orders", "routes", "create-optimized", ""]
                }
              }
            },
            {
              "name": "List Routes (Filter by Date)",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{city_url}}/api/erp/orders/routes/?delivery_date=2026-05-08",
                  "host": ["{{city_url}}"],
                  "path": ["api", "erp", "orders", "routes", ""],
                  "query": [
                    { "key": "delivery_date", "value": "2026-05-08" }
                  ]
                }
              }
            },
            {
              "name": "List All Routes",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{city_url}}/api/erp/orders/routes/",
                  "host": ["{{city_url}}"],
                  "path": ["api", "erp", "orders", "routes", ""]
                }
              }
            },
            {
              "name": "Update Route (Assign Driver)",
              "request": {
                "method": "PATCH",
                "body": { "mode": "raw", "raw": "{\n  \"driver\": \"{{driver_id}}\"\n}", "options": { "raw": { "language": "json" } } },
                "url": {
                  "raw": "{{city_url}}/api/erp/orders/routes/{{route_id}}/",
                  "host": ["{{city_url}}"],
                  "path": ["api", "erp", "orders", "routes", "{{route_id}}", ""]
                }
              }
            },
            {
              "name": "Get My Route (Driver App)",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{city_url}}/api/erp/orders/driver/my-route/",
                  "host": ["{{city_url}}"],
                  "path": ["api", "erp", "orders", "driver", "my-route", ""]
                }
              }
            },
            {
              "name": "Start Trip",
              "request": {
                "method": "POST",
                "url": {
                  "raw": "{{city_url}}/api/erp/orders/driver/{{route_id}}/start-trip/",
                  "host": ["{{city_url}}"],
                  "path": ["api", "erp", "orders", "driver", "{{route_id}}", "start-trip", ""]
                }
              }
            },
            {
              "name": "Submit Delivery (One-Tap)",
              "request": {
                "method": "POST",
                "url": {
                  "raw": "{{city_url}}/api/erp/orders/driver/{{order_id}}/submit-delivery/",
                  "host": ["{{city_url}}"],
                  "path": ["api", "erp", "orders", "driver", "{{order_id}}", "submit-delivery", ""]
                }
              }
            },
            {
              "name": "Complete Trip",
              "request": {
                "method": "POST",
                "url": {
                  "raw": "{{city_url}}/api/erp/orders/driver/{{route_id}}/complete-trip/",
                  "host": ["{{city_url}}"],
                  "path": ["api", "erp", "orders", "driver", "{{route_id}}", "complete-trip", ""]
                }
              }
            }
          ]
        }
