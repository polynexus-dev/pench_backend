    {
      "name": "12. WebSocket (Live Tracking)",
      "item": [
        {
          "name": "Connect to Live Tracking",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Host",
                "value": "nagpur.pench.api.polynexus.in",
                "description": "Must match the tenant domain"
              }
            ],
            "url": {
              "raw": "ws://{{base_url}}/ws/tracking/?token={{bearer_token}}",
              "protocol": "ws",
              "host": ["{{base_url}}"],
              "path": ["ws", "tracking", ""],
              "query": [
                {
                  "key": "token",
                  "value": "{{bearer_token}}",
                  "description": "JWT Token"
                }
              ]
            },
            "description": "WebSocket endpoint for real-time driver tracking. \n\n**Instructions:**\n1. Use a WebSocket client (Postman WebSocket Request or browser extension).\n2. Connect to `ws://<your-domain>/ws/tracking/?token=<jwt_token>`.\n3. Send location updates as JSON: `{\"lat\": 21.1, \"lng\": 79.1}`.\n4. Admins will receive broadcasts of all active drivers."
          }
        }
      ]
    }
