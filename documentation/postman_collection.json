    {
      "name": "4. Logistics & Driver App",
      "item": [
        {
          "name": "Driver Onboarding (2-Step Process)",
          "item": [
            {
              "name": "Step 1: Bulk Create Global Driver Accounts (Public)",
              "request": {
                "method": "POST",
                "body": { "mode": "raw", "raw": "[\n    {\n        \"username\": \"driver1\",\n        \"password\": \"pass123\",\n        \"phone\": \"+919999888001\",\n        \"is_driver\": true\n    }\n]", "options": { "raw": { "language": "json" } } },
                "url": {
                  "raw": "{{base_url}}/api/accounts/register/",
                  "host": ["{{base_url}}"],
                  "path": ["api", "accounts", "register", ""]
                }
              }
            },
            {
              "name": "Step 2: Bulk Assign Drivers to City Profile (Tenant)",
              "request": {
                "method": "POST",
                "body": { "mode": "raw", "raw": "[\n    {\n        \"user\": 10,\n        \"vehicle_plate\": \"MH-31-AA-1001\",\n        \"vehicle_type\": \"mini_van\"\n    }\n]", "options": { "raw": { "language": "json" } } },
                "url": {
                  "raw": "{{city_url}}/api/ems/drivers/",
                  "host": ["{{city_url}}"],
                  "path": ["api", "ems", "drivers", ""]
                }
              }
            },
            {
              "name": "List Drivers in This City",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{city_url}}/api/ems/drivers/",
                  "host": ["{{city_url}}"],
                  "path": ["api", "ems", "drivers", ""]
                }
              }
            }
          ]
        },
        {
          "name": "Orders",
          "item": [
            {
              "name": "List Orders",
              "request": {
                "method": "GET",
