                  "path": ["api", "erp", "inventory", "products", ""]
                }
              }
            },
            {
              "name": "Create Product (Single or Bulk)",
              "request": {
                "method": "POST",
                "body": { "mode": "raw", "raw": "[{\"name\": \"Milk 1L\", \"sku\": \"M1L\", \"unit_price\": 60}]", "options": { "raw": { "language": "json" } } },
                "url": {
                  "raw": "{{city_url}}/api/erp/inventory/products/",
                  "host": ["{{city_url}}"],
                  "path": ["api", "erp", "inventory", "products", ""]
                }
              }
            },
            {
              "name": "Bulk Update Products",
              "request": {
                "method": "PATCH",
