      "item": [
        {
          "name": "Login (Staff/ERP)",
          "event": [
            {
              "listen": "test",
              "script": { "exec": [ "var jsonData = pm.response.json(); if (jsonData.access) { pm.collectionVariables.set(\"bearer_token\", jsonData.access); }" ], "type": "text/javascript" }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
